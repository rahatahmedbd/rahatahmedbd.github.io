# Rahat Ahmed Portfolio — local environment template
# 1. Copy this file to `.env.local` in the repository root.
# 2. Paste your own values after each `=`.
# 3. Never commit `.env.local` or any real secret.
#
# Only variables beginning with NEXT_PUBLIC_ are exposed to browser code.
# The service-role key and Cloudinary API secret must remain server-only.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
