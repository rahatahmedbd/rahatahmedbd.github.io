# Public Supabase browser configuration (safe to expose in client bundles).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase credential. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary media delivery/upload configuration.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=kbc3dfnj
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional comma-separated bootstrap admin emails.
ADMIN_EMAILS=admin@example.com

# Optional canonical application URL used by auth redirects.
NEXT_PUBLIC_APP_URL=https://rahatahmedbd.github.io
