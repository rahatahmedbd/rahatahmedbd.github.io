# ──────────────────────────────────────────────────────────────────────────
# Rahat Ahmed Portfolio — Environment Variables (TEMPLATE)
# Copy to `.env.local` and fill in. Only NEXT_PUBLIC_* vars reach the browser.
# ──────────────────────────────────────────────────────────────────────────

# Contact form (Phase 1) — Formspree form ID (the part after /f/).
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID

# ── Supabase (future phases: Auth, DB, Storage, RLS) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://aaejtdpadrxwplomraog.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Cloudinary (file uploads) ──────────────────────────────────────────────
# See SETUP_REQUIRED.md for step-by-step instructions.
#
# Leave the preset blank and uploads are cleanly disabled with a message
# telling people to send files by email — nothing breaks, nothing is lost.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=kbc3dfnj

# Name of an UNSIGNED upload preset created in the Cloudinary console.
# Public by design (it is not a secret) — enables browser uploads.
# Set a max file size and allowed formats on the preset itself.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Server-only. Enables signed admin uploads at /admin/media without a public
# preset. NEVER prefix these with NEXT_PUBLIC_ — they must not reach the browser.
# CLOUDINARY_API_KEY=your_api_key_here
# CLOUDINARY_API_SECRET=your_api_secret_here

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rahatahmedbd.github.io
