# ──────────────────────────────────────────────────────────────────────────
# Rahat Ahmed Portfolio — Environment Variables (TEMPLATE)
# Copy to `.env.local` and fill in. Only NEXT_PUBLIC_* vars reach the browser.
# ──────────────────────────────────────────────────────────────────────────

# Contact form (Phase 1) — Formspree form ID (the part after /f/).
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID

# ── Supabase (future phases: Auth, DB, Storage, RLS) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://aaejtdpadrxwplomraog.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # server-only, NEVER expose

# ── Cloudinary (future phases: image hosting, optimization, CDN) ───────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=kbc3dfnj
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here
# CLOUDINARY_API_KEY=your_api_key_here                   # server-only
# CLOUDINARY_API_SECRET=your_api_secret_here             # server-only

# ── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rahatahmedbd.github.io
